@inherits LayoutComponentBase
@implements IDisposable
@using CommunityToolkit.Mvvm.Messaging
@using TrackHubMobile.Messages

<div class="page">
	@if (_suspended)
	{
		<main class="suspended">
			<i class="fas fa-lock"></i>
			<p>@LRM["AccountUnavailable"]</p>
		</main>
	}
	else
	{
		<main>
			<article class="content">
				@Body
			</article>
		</main>
		<NavMenu />
	}
</div>

@code {
	private bool _suspended;

	protected override void OnInitialized()
	{
		WeakReferenceMessenger.Default.Register<AccountSuspendedMessage>(this, (r, m) =>
		{
			_suspended = m.Value;
			InvokeAsync(StateHasChanged);
		});
	}

	public void Dispose()
	{
		WeakReferenceMessenger.Default.Unregister<AccountSuspendedMessage>(this);
	}
}
