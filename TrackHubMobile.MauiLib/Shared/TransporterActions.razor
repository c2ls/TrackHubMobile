<div class="unit-actions">
    @if (ShowDetailsButton)
    {
        <button class="unit-action" @onclick="ViewDetails">
            <span class="action-icon"><i class="fas fa-info"></i></span>
            <span class="action-label">@LRM["ViewDetails"]</span>
        </button>
    }
    <button class="unit-action" @onclick="ViewHistory">
        <span class="action-icon"><i class="fas fa-history"></i></span>
        <span class="action-label">@LRM["History"]</span>
    </button>
    @if (!ShowDetailsButton)
    {
        <button class="unit-action" @onclick="ShowOnMap">
            <span class="action-icon"><i class="fas fa-map-marked-alt"></i></span>
            <span class="action-label">@LRM["LiveMap"]</span>
        </button>
    }
    <button class="unit-action" @onclick="OpenInGoogleMaps">
        <span class="action-icon"><i class="fas fa-location-arrow"></i></span>
        <span class="action-label">@LRM["OpenInGoogleMaps"]</span>
    </button>
    <button class="unit-action" @onclick="ShareViaWhatsApp">
        <span class="action-icon"><i class="fab fa-whatsapp"></i></span>
        <span class="action-label">@LRM["ShareLocation"]</span>
    </button>
</div>
