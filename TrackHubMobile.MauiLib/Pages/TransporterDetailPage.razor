@page "/transporter/{TransporterIdParam}"

@inherits ActiveScreenComponentBase
@inject TransporterDetailViewModel ViewModel
@inject ITransporterHelper transporterHelper

<div class="detail-page">
    <div class="mini-map">
        <div id="map"></div>
        <button class="fab back-fab" @onclick="GoBackAsync" title="@LRM["Back"]" aria-label="@LRM["Back"]">
            <i class="fas fa-arrow-left"></i>
        </button>
    </div>

    @if (ViewModel.Transporter is { } unit)
    {
        var status = ViewModel.StatusRules.DisplayStatusOf(unit, DateTimeOffset.UtcNow);
        var location = transporterHelper.GetLocation(unit);
        var attributes = unit.Attributes;
        <div class="detail-content">
            <div class="detail-head">
                <div class="detail-title">
                    <h1>@unit.DeviceName</h1>
                    @if (location.Length > 0)
                    {
                        <span>@location</span>
                    }
                    <span>@LRM["LastUpdate"]: @transporterHelper.GetTimeDifference(unit.DeviceDateTime)</span>
                </div>
                <span class="status-pill @status.CssClass()">@transporterHelper.GetStatusName(status)</span>
            </div>

            <TransporterActions Transporter="unit" ShowDetailsButton="false" />

            <div class="metric-tiles">
                <div class="metric-tile">
                    <span class="metric-value">@unit.Speed.ToString("N0")</span>
                    <span class="metric-label">km/h</span>
                </div>
                @if (attributes?.Ignition is { } ignition)
                {
                    <div class="metric-tile">
                        <span class="metric-value @(ignition ? "st-moving" : "st-offline")">@transporterHelper.GetAccStatus(ignition)</span>
                        <span class="metric-label">@LRM["AccStatus"]</span>
                    </div>
                }
                @if (attributes?.Mileage is { } mileage)
                {
                    <div class="metric-tile">
                        <span class="metric-value">@mileage.ToString("N0")</span>
                        <span class="metric-label">@LRM["Odometer"] · km</span>
                    </div>
                }
            </div>

            <div class="detail-card">
                <div class="detail-row">
                    <span class="detail-label">@LRM["LastReport"]</span>
                    <span class="detail-value">@unit.DeviceDateTime.ToLocalTime().ToString("g")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@LRM["TransporterType"]</span>
                    <span class="detail-value">@transporterHelper.GetTransporterTypeName(unit.TransporterType)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@LRM["Coordinates"]</span>
                    <span class="detail-value">@unit.Latitude.ToString("F6"), @unit.Longitude.ToString("F6")</span>
                </div>
                @if (unit.Altitude is { } altitude)
                {
                    <div class="detail-row">
                        <span class="detail-label">@LRM["Altitude"]</span>
                        <span class="detail-value">@altitude.ToString("F1") m</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(unit.State))
                {
                    <div class="detail-row">
                        <span class="detail-label">@LRM["State"]</span>
                        <span class="detail-value">@unit.State</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(unit.Country))
                {
                    <div class="detail-row">
                        <span class="detail-label">@LRM["Country"]</span>
                        <span class="detail-value">@unit.Country</span>
                    </div>
                }
                @if (attributes?.Temperature is { } temperature)
                {
                    <div class="detail-row">
                        <span class="detail-label">@LRM["Temperature"]</span>
                        <span class="detail-value">@temperature.ToString("F1") °C</span>
                    </div>
                }
                @if (attributes?.Satellites is { } satellites)
                {
                    <div class="detail-row">
                        <span class="detail-label">@LRM["Satellites"]</span>
                        <span class="detail-value">@satellites</span>
                    </div>
                }
                @if (attributes?.Hourmeter is { } hourmeter)
                {
                    <div class="detail-row">
                        <span class="detail-label">@LRM["Hourmeter"]</span>
                        <span class="detail-value">@hourmeter.ToString("N1") h</span>
                    </div>
                }
            </div>
        </div>
    }
    else if (ViewModel.HasError)
    {
        <div class="empty-state">
            <i class="fas fa-exclamation-triangle"></i>
            <p>@LRM["Error"]</p>
        </div>
    }
    else
    {
        <div class="detail-content">
            <div class="skeleton" style="height: 3.5rem"></div>
            <div class="skeleton" style="height: 4.5rem"></div>
            <div class="skeleton" style="height: 12rem"></div>
        </div>
    }
</div>
