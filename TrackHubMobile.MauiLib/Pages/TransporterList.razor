@page "/listview"

@inherits ActiveScreenComponentBase
@inject TransporterListViewModel ViewModel
@inject ITransporterHelper transporterHelper

<div class="list-page">
    <div class="list-header">
        <div class="page-head">
            <h1 class="page-title">@LRM["Transporters"]</h1>
            @if (ViewModel.FilteredTransporters is { } shown)
            {
                <span class="page-sub">@shown.Count / @ViewModel.Counts[UnitFilter.All]</span>
            }
        </div>
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="search"
                   class="form-control"
                   placeholder="@LRM["SearchUnits"]..."
                   value="@ViewModel.SearchText"
                   @oninput="OnSearchInput" />
        </div>
        <div class="chip-row">
            @foreach (var filter in Enum.GetValues<UnitFilter>())
            {
                <button @key="filter" class="chip @filter.CssClass() @(ViewModel.Filter == filter ? "selected" : "")"
                        @onclick="() => ViewModel.SetFilter(filter)">
                    @if (filter != UnitFilter.All)
                    {
                        <span class="status-dot"></span>
                    }
                    @transporterHelper.GetFilterName(filter) @ViewModel.Counts.GetValueOrDefault(filter)
                </button>
            }
        </div>
    </div>

    @if (ViewModel.Transporters is null)
    {
        <div class="unit-list">
            @for (var i = 0; i < 6; i++)
            {
                <div class="skeleton skeleton-row"></div>
            }
        </div>
    }
    else if (ViewModel.FilteredTransporters is not { Count: > 0 })
    {
        <div class="empty-state">
            <i class="fas fa-truck"></i>
            <p>@LRM["NoUnitsFound"]</p>
        </div>
    }
    else
    {
        <div class="unit-list">
            <Virtualize Items="ViewModel.FilteredTransporters" Context="row" ItemSize="68" OverscanCount="6">
                @{
                    var unit = row.Unit;
                    var location = transporterHelper.GetLocation(unit);
                    var isMoving = row.Status is UnitDisplayStatus.Moving or UnitDisplayStatus.Speeding;
                }
                <button @key="unit.TransporterId" class="unit-row @row.Status.CssClass()" @onclick="() => OpenUnit(unit.TransporterId)">
                    <span class="status-dot"></span>
                    <span class="unit-info">
                        <span class="unit-name">@unit.DeviceName</span>
                        <span class="unit-place">@(location.Length > 0 ? location : transporterHelper.GetTransporterTypeName(unit.TransporterType))</span>
                    </span>
                    <span class="unit-meta">
                        @if (isMoving)
                        {
                            <span class="unit-value">@unit.Speed.ToString("N0")</span>
                            <span class="unit-unit">km/h</span>
                        }
                        else
                        {
                            <span class="unit-unit">@transporterHelper.GetTimeDifference(unit.DeviceDateTime)</span>
                        }
                    </span>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </Virtualize>
        </div>
    }
</div>
