@page "/"

@inherits ActiveScreenComponentBase
@inject HomeViewModel ViewModel
@inject ITransporterHelper transporterHelper

<div class="dashboard-page">
    <div class="page-head">
        <h1 class="page-title">@LRM["Dashboard"]</h1>
        @if (ViewModel.LastGlobalUpdate.HasValue)
        {
            <span class="page-sub">@LRM["LastGlobalUpdate"]: @transporterHelper.GetTimeDifference(ViewModel.LastGlobalUpdate.Value)</span>
        }
    </div>

    @if (!ViewModel.IsLoaded)
    {
        <div class="skeleton" style="height: 17rem"></div>
        <div class="skeleton" style="height: 9rem"></div>
    }
    else
    {
        <section class="fleet-card">
            <button class="fleet-total" @onclick="OpenMap">
                <span class="fleet-value">@ViewModel.Total</span>
                <span class="fleet-meta">
                    <strong>@LRM["TotalUnits"]</strong>
                    <span>@ViewModel.IgnitionOn @LRM["IgnitionOn"] · @LRM["AvgSpeed"] @ViewModel.AverageSpeed km/h</span>
                </span>
                <i class="fas fa-map-marked-alt"></i>
            </button>

            @if (ViewModel.Total > 0)
            {
                <div class="fleet-bar">
                    @foreach (var (css, count) in new[]
                    {
                        ("st-moving", ViewModel.InMovement - ViewModel.Speeding),
                        ("st-speeding", ViewModel.Speeding),
                        ("st-stopped", ViewModel.Stopped),
                        ("st-offline", ViewModel.Offline)
                    })
                    {
                        if (count > 0)
                        {
                            <span class="@css" style="flex-grow: @count"></span>
                        }
                    }
                </div>
            }

            <button class="status-row st-moving" @onclick="() => OpenList(UnitFilter.Moving)">
                <span class="status-dot"></span>
                <span class="status-name">@LRM["InMovement"]</span>
                <span class="status-count">@ViewModel.InMovement</span>
                <i class="fas fa-chevron-right"></i>
            </button>
            <button class="status-row st-stopped" @onclick="() => OpenList(UnitFilter.Stopped)">
                <span class="status-dot"></span>
                <span class="status-name">@LRM["Stopped"]</span>
                <span class="status-count">@ViewModel.Stopped</span>
                <i class="fas fa-chevron-right"></i>
            </button>
            <button class="status-row st-offline" @onclick="() => OpenList(UnitFilter.Offline)">
                <span class="status-dot"></span>
                <span class="status-name">@LRM["Offline"]</span>
                <span class="status-count">@ViewModel.Offline</span>
                <i class="fas fa-chevron-right"></i>
            </button>
            <button class="status-row st-speeding" @onclick="() => OpenList(UnitFilter.Speeding)">
                <span class="status-dot"></span>
                <span class="status-name">@LRM["Speeding"]</span>
                <span class="status-count">@ViewModel.Speeding</span>
                <i class="fas fa-chevron-right"></i>
            </button>
        </section>

        @if (ViewModel.Attention.Count > 0)
        {
            <h2 class="section-label">@LRM["NeedsAttention"]</h2>
            <section class="attention-card">
                @foreach (var unit in ViewModel.Attention)
                {
                    var status = ViewModel.StatusRules.DisplayStatusOf(unit, DateTimeOffset.UtcNow);
                    <button @key="unit.TransporterId" class="attention-row" @onclick="() => OpenUnit(unit.TransporterId)">
                        <span class="attention-body">
                            <span class="attention-name">@unit.DeviceName</span>
                            <span class="attention-detail">
                                @(status == UnitDisplayStatus.Speeding
                                    ? $"{unit.Speed:N0} km/h"
                                    : transporterHelper.GetTimeDifference(unit.DeviceDateTime))
                            </span>
                        </span>
                        <span class="status-pill @status.CssClass()">@transporterHelper.GetStatusName(status)</span>
                    </button>
                }
            </section>
        }
    }
</div>
